<div class="ugc-gallery section-{{ section.id }}-padding page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="h2" style="text-align: center; margin-bottom: 3rem;">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <div class="ugc-gallery__grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--grid-mobile-horizontal-spacing);">
    {%- for block in section.blocks -%}
      <div class="ugc-gallery__item" {{ block.shopify_attributes }} style="position: relative; padding-bottom: 100%; overflow: hidden;">
        {%- if block.settings.image != blank -%}
          <a href="{{ block.settings.link | default: '#' }}" style="display: block; width: 100%; height: 100%;">
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.image.alt | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;">
          </a>
        {%- else -%}
          <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #eee;">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.button_label != blank -%}
    <div style="text-align: center; margin-top: 3rem;">
      <a href="{{ section.settings.button_link }}" class="button button--secondary">{{ section.settings.button_label | escape }}</a>
    </div>
  {%- endif -%}
</div>

<style>
  .ugc-gallery__item:hover img {
    transform: scale(1.05);
  }
  @media screen and (min-width: 750px) {
    .ugc-gallery__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr) !important;
      gap: var(--grid-desktop-horizontal-spacing) !important;
    }
  }
</style>

{% schema %}
{
  "name": "UGC Gallery",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "@Riyah on Instagram",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Desktop columns"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Follow Us",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGC Gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
