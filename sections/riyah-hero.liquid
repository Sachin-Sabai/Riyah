<style>
  hero-slider {
    display: block;
    position: relative;
    overflow: hidden;
    min-height: 80vh;
    background: #000;
  }
  .riyah-hero__slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1s cubic-bezier(0.25, 0.46, 0.45, 0.94), visibility 1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .riyah-hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }
  .riyah-hero__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .riyah-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  .riyah-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
  }
  
  /* Stagger animation setup */
  .riyah-hero__slide .animate--stagger-words .word {
    display: inline-block;
    opacity: 0;
    transform: translateY(20px);
  }
  .riyah-hero__slide.is-active .animate--stagger-words .word {
    animation: slideUpFade 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }
  
  @keyframes slideUpFade {
    0% { opacity: 0; transform: translateY(20px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  /* Navigation UI */
  .riyah-hero__nav {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 1rem;
    z-index: 3;
  }
  .riyah-hero__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255,255,255,0.4);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.3s ease;
  }
  .riyah-hero__dot:hover {
    background: rgba(255,255,255,0.8);
  }
  .riyah-hero__dot.is-active {
    background: rgba(255,255,255,1);
  }
  .riyah-hero__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0,0,0,0.3);
    color: #fff;
    border: none;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
    opacity: 0;
    transition: opacity 0.3s ease, background 0.3s ease;
  }
  .riyah-hero__arrow:hover {
    background: rgba(0,0,0,0.8);
  }
  .riyah-hero__arrow--left { left: 2rem; }
  .riyah-hero__arrow--right { right: 2rem; }
  
  hero-slider:hover .riyah-hero__arrow {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .riyah-hero__arrow { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .riyah-hero__slide {
      transition: none !important;
    }
    .riyah-hero__slide.is-active .animate--stagger-words .word {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<hero-slider 
  data-autoplay="{{ section.settings.auto_play }}" 
  data-interval="{{ section.settings.slide_interval | times: 1000 }}"
>
  {%- for block in section.blocks -%}
    <div class="riyah-hero__slide {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
      {%- if block.settings.media_type == 'video' -%}
        {%- if block.settings.video != blank -%}
          <video class="riyah-hero__media" autoplay loop muted playsinline {% if block.settings.image != blank %}poster="{{ block.settings.image | image_url: width: 2000 }}"{% endif %}>
            <source src="{{ block.settings.video.sources[1].url }}" type="{{ block.settings.video.sources[1].mime_type }}">
            <source src="{{ block.settings.video.sources[0].url }}" type="{{ block.settings.video.sources[0].mime_type }}">
          </video>
        {%- elsif block.settings.video_url != blank -%}
          <iframe class="riyah-hero__media" style="width: 100vw; height: 56.25vw; min-height: 100vh; min-width: 177.77vh; top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: none;" src="https://{% if block.settings.video_url.type == 'youtube' %}www.youtube.com/embed/{{ block.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ block.settings.video_url.id }}&controls=0&showinfo=0{% else %}player.vimeo.com/video/{{ block.settings.video_url.id }}?background=1&autoplay=1&loop=1&byline=0&title=0&muted=1{% endif %}" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
        {%- endif -%}
      {%- else -%}
        {%- if block.settings.image != blank -%}
          <img class="riyah-hero__media" src="{{ block.settings.image | image_url: width: 2000 }}" alt="{{ block.settings.heading | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
        {%- else -%}
          <div class="riyah-hero__media" style="background: #333;"></div>
        {%- endif -%}
      {%- endif -%}

      <div class="riyah-hero__overlay" style="background: rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by: 100.0 }});"></div>

      <div class="riyah-hero__content page-width">
        {%- if block.settings.heading != blank -%}
          <h2 class="h1 {{ section.settings.text_animation }}" style="margin-bottom: 1rem; text-shadow: 0 4px 12px rgba(0,0,0,0.6);">
            {%- if section.settings.text_animation == 'animate--stagger-words' -%}
              {%- assign words = block.settings.heading | split: ' ' -%}
              {%- for word in words -%}
                <span class="word" style="animation-delay: {{ forloop.index | times: 0.08 }}s;">{{ word }}</span>{% unless forloop.last %} {% endunless %}
              {%- endfor -%}
            {%- else -%}
              {{ block.settings.heading | escape }}
            {%- endif -%}
          </h2>
        {%- endif -%}

        {%- if block.settings.text != blank -%}
          <p class="h3" style="margin-bottom: 2rem; text-shadow: 0 2px 8px rgba(0,0,0,0.6);">{{ block.settings.text | escape }}</p>
        {%- endif -%}

        <div class="riyah-hero__buttons">
          {%- if block.settings.button_label_1 != blank -%}
            <a href="{{ block.settings.button_link_1 }}" class="button button--primary">{{ block.settings.button_label_1 | escape }}</a>
          {%- endif -%}
          {%- if block.settings.button_label_2 != blank -%}
            <a href="{{ block.settings.button_link_2 }}" class="button button--secondary" style="margin-left: 1rem; border-color: #fff; color: #fff;">{{ block.settings.button_label_2 | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endfor -%}

  {%- if section.blocks.size > 1 -%}
    <button class="riyah-hero__arrow riyah-hero__arrow--left" aria-label="Previous slide">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <button class="riyah-hero__arrow riyah-hero__arrow--right" aria-label="Next slide">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>

    <div class="riyah-hero__nav">
      {%- for block in section.blocks -%}
        <button class="riyah-hero__dot {% if forloop.first %}is-active{% endif %}" aria-label="Go to slide {{ forloop.index }}" data-index="{{ forloop.index0 }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</hero-slider>

<script>
  if (!customElements.get('hero-slider')) {
    customElements.define('hero-slider', class HeroSlider extends HTMLElement {
      constructor() {
        super();
        this.slides = this.querySelectorAll('.riyah-hero__slide');
        this.dots = this.querySelectorAll('.riyah-hero__dot');
        this.prevBtn = this.querySelector('.riyah-hero__arrow--left');
        this.nextBtn = this.querySelector('.riyah-hero__arrow--right');
        
        if (this.slides.length <= 1) return;
        
        this.activeIndex = 0;
        this.autoPlay = this.dataset.autoplay === 'true';
        this.interval = parseInt(this.dataset.interval) || 5000;
        this.timer = null;
        
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        if (prefersReducedMotion.matches) this.autoPlay = false;

        this.bindEvents();
        if (this.autoPlay) this.startTimer();
      }

      bindEvents() {
        if (this.prevBtn) this.prevBtn.addEventListener('click', () => this.goToSlide(this.activeIndex - 1));
        if (this.nextBtn) this.nextBtn.addEventListener('click', () => this.goToSlide(this.activeIndex + 1));
        
        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToSlide(index));
        });

        this.addEventListener('mouseenter', () => this.stopTimer());
        this.addEventListener('mouseleave', () => {
          if (this.autoPlay) this.startTimer();
        });

        let startX = 0;
        this.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          this.stopTimer();
        }, { passive: true });
        
        this.addEventListener('touchend', (e) => {
          const endX = e.changedTouches[0].clientX;
          if (startX - endX > 50) this.goToSlide(this.activeIndex + 1);
          else if (endX - startX > 50) this.goToSlide(this.activeIndex - 1);
          if (this.autoPlay) this.startTimer();
        }, { passive: true });
      }

      goToSlide(index) {
        this.slides[this.activeIndex].classList.remove('is-active');
        if (this.dots[this.activeIndex]) this.dots[this.activeIndex].classList.remove('is-active');

        if (index >= this.slides.length) this.activeIndex = 0;
        else if (index < 0) this.activeIndex = this.slides.length - 1;
        else this.activeIndex = index;

        this.slides[this.activeIndex].classList.add('is-active');
        if (this.dots[this.activeIndex]) this.dots[this.activeIndex].classList.add('is-active');

        if (this.autoPlay) {
          this.stopTimer();
          this.startTimer();
        }
      }

      startTimer() {
        this.timer = setInterval(() => this.goToSlide(this.activeIndex + 1), this.interval);
      }

      stopTimer() {
        clearInterval(this.timer);
      }
    });
  }
</script>

{% schema %}
{
  "name": "Riyah Hero Carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_play",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "slide_interval",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 5
    },
    {
      "type": "select",
      "id": "text_animation",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "animate--stagger-words", "label": "Stagger Words" }
      ],
      "default": "animate--stagger-words",
      "label": "Text Animation"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 5,
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image",
          "label": "Media type"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Used as background image or video poster fallback."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (MP4)"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "accept": ["youtube", "vimeo"],
          "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
          "label": "Video URL (YouTube/Vimeo)"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Overlay opacity",
          "default": 30
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Elevate Your Style",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "default": "Discover the new collection.",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label_1",
          "default": "Shop Men",
          "label": "Button 1 label"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "Button 1 link"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "default": "Shop Women",
          "label": "Button 2 label"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Button 2 link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Riyah Hero Carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
