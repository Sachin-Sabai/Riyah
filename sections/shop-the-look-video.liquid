{{ 'video-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .shop-the-look-video {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
  }
  @media screen and (min-width: 750px) {
    .shop-the-look-video {
      flex-direction: row;
    }
    .shop-the-look-video--right .shop-the-look-video__media-wrapper {
      order: 2;
    }
    .shop-the-look-video--right .shop-the-look-video__content-wrapper {
      order: 1;
    }
  }
  .shop-the-look-video__media-wrapper,
  .shop-the-look-video__content-wrapper {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .shop-the-look-video__media-wrapper {
    position: relative;
    min-height: 50vh;
  }
  @media screen and (min-width: 750px) {
    .shop-the-look-video__media-wrapper {
      min-height: {{ section.settings.video_height }}vh;
    }
  }
  .shop-the-look-video__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  .shop-the-look-video__media video,
  .shop-the-look-video__media iframe,
  .shop-the-look-video__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: none;
  }
  .shop-the-look-video__poster {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .shop-the-look-video__media video,
    .shop-the-look-video__media iframe {
      display: none !important;
    }
    .shop-the-look-video__poster {
      display: block !important;
    }
  }
  .shop-the-look-video__content {
    padding: 4rem 2rem;
    text-align: {{ section.settings.text_alignment }};
    max-width: 600px;
  }
  .shop-the-look-video__content .h2 {
    margin-bottom: 1rem;
  }
  .shop-the-look-video__content .rte {
    margin-bottom: 2rem;
  }
{%- endstyle -%}

<div class="shop-the-look-video shop-the-look-video--{{ section.settings.video_position }} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="shop-the-look-video__media-wrapper">
    <div class="shop-the-look-video__media">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: image_size: "800x", autoplay: section.settings.autoplay, loop: section.settings.loop, muted: section.settings.muted, controls: false, playsinline: true, loading: 'lazy' }}
      {%- elsif section.settings.video_url != blank -%}
        {%- liquid
          assign video_id = section.settings.video_url.id
          assign loop_param = ''
          if section.settings.loop
            assign loop_param = '&loop=1&playlist=' | append: video_id
          endif
          assign autoplay_param = ''
          if section.settings.autoplay
            assign autoplay_param = '&autoplay=1&mute=1'
          endif
        -%}
        {%- if section.settings.video_url.type == 'youtube' -%}
          <iframe src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&controls=0&rel=0{{ autoplay_param }}{{ loop_param }}" loading="lazy" allow="autoplay; encrypted-media"></iframe>
        {%- else -%}
          <iframe src="https://player.vimeo.com/video/{{ video_id }}?controls=0&background=1{{ autoplay_param }}{{ loop_param }}" loading="lazy" allow="autoplay; encrypted-media"></iframe>
        {%- endif -%}
      {%- endif -%}
      
      {%- if section.settings.cover_image != blank -%}
        <img class="shop-the-look-video__poster" src="{{ section.settings.cover_image | image_url: width: 1000 }}" alt="{{ section.settings.cover_image.alt | escape }}" loading="lazy" width="{{ section.settings.cover_image.width }}" height="{{ section.settings.cover_image.height }}">
      {%- endif -%}
    </div>
  </div>

  <div class="shop-the-look-video__content-wrapper">
    <div class="shop-the-look-video__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <div class="rte">{{ section.settings.subtext }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--primary">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop the Look Video",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video (MP4)",
      "info": "Recommended for best performance and seamless autoplay."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "External Video URL",
      "info": "Used if no Shopify-hosted video is provided."
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Poster Image",
      "info": "Shown on devices with reduced motion preferences."
    },
    {
      "type": "range",
      "id": "video_height",
      "min": 40,
      "max": 100,
      "step": 10,
      "unit": "vh",
      "label": "Desktop height",
      "default": 80
    },
    {
      "type": "select",
      "id": "video_position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Desktop video position"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Mute video",
      "default": true
    },
    {
      "type": "header",
      "content": "Text Overlay"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop This Look"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Get the complete outfit featured in this video.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "label": "Text alignment"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Shop the Look Video"
    }
  ]
}
{% endschema %}
