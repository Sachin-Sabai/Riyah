<div class="logo-marquee logo-marquee--direction-{{ section.settings.direction }} section-{{ section.id }}-padding" style="--marquee-speed: {{ section.settings.speed }}s; background-color: {{ section.settings.background_color }};">
  <div class="logo-marquee__track">
    {%- for i in (1..2) -%}
      <div style="display: flex; gap: 4rem; align-items: center; padding-right: 4rem;">
        {%- for block in section.blocks -%}
          <div class="logo-marquee__item" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.image.alt | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
            {%- else -%}
              <div style="width: 150px; height: 50px; background: #ddd; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; color: #555;">Logo</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

<style>
  .logo-marquee {
    overflow: hidden;
    white-space: nowrap;
    padding: 2rem 0;
  }
  .logo-marquee__track {
    display: flex;
    width: max-content;
    animation: marquee var(--marquee-speed, 30s) linear infinite;
  }
  .logo-marquee--direction-right .logo-marquee__track {
    animation-direction: reverse;
  }
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .logo-marquee__item {
    flex-shrink: 0;
  }
  .logo-marquee__item img {
    display: block;
    max-width: 150px;
    height: auto;
    object-fit: contain;
  }
</style>

{% schema %}
{
  "name": "Logo Marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll speed (slower = higher number)",
      "default": 30
    },
    {
      "type": "select",
      "id": "direction",
      "options": [
        { "value": "left", "label": "Left to Right" },
        { "value": "right", "label": "Right to Left" }
      ],
      "default": "left",
      "label": "Scroll direction"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Marquee",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
