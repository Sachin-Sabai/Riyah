{{ 'video-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .brand-story-video {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .brand-story-video__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  .brand-story-video__media::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #000;
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }
  .brand-story-video__media video,
  .brand-story-video__media iframe,
  .brand-story-video__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: none;
  }
  .brand-story-video__poster {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .brand-story-video__media video,
    .brand-story-video__media iframe {
      display: none !important;
    }
    .brand-story-video__poster {
      display: block !important;
    }
  }
  .brand-story-video__content {
    position: relative;
    z-index: 3;
    text-align: center;
    padding: 4rem 2rem;
    color: {{ section.settings.text_color }};
    width: 100%;
    max-width: 800px;
  }
  .brand-story-video__content .h1 {
    color: inherit;
    margin-bottom: 1rem;
  }
  .brand-story-video__content .rte {
    color: inherit;
    font-size: 1.2rem;
    margin-bottom: 2rem;
  }
{%- endstyle -%}

<div class="brand-story-video section-{{ section.id }}-padding" style="min-height: {{ section.settings.video_height }}vh;">
  <div class="brand-story-video__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: image_size: "1100x", autoplay: section.settings.autoplay, loop: section.settings.loop, muted: section.settings.muted, controls: false, playsinline: true, loading: 'lazy' }}
    {%- elsif section.settings.video_url != blank -%}
      {%- liquid
        assign video_id = section.settings.video_url.id
        assign loop_param = ''
        if section.settings.loop
          assign loop_param = '&loop=1&playlist=' | append: video_id
        endif
        assign autoplay_param = ''
        if section.settings.autoplay
          assign autoplay_param = '&autoplay=1&mute=1'
        endif
      -%}
      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&controls=0&rel=0{{ autoplay_param }}{{ loop_param }}" loading="lazy" allow="autoplay; encrypted-media"></iframe>
      {%- else -%}
        <iframe src="https://player.vimeo.com/video/{{ video_id }}?controls=0&background=1{{ autoplay_param }}{{ loop_param }}" loading="lazy" allow="autoplay; encrypted-media"></iframe>
      {%- endif -%}
    {%- endif -%}
    
    {%- if section.settings.cover_image != blank -%}
      <img class="brand-story-video__poster" src="{{ section.settings.cover_image | image_url: width: 1500 }}" alt="{{ section.settings.cover_image.alt | escape }}" loading="lazy" width="{{ section.settings.cover_image.width }}" height="{{ section.settings.cover_image.height }}">
    {%- endif -%}
  </div>

  <div class="brand-story-video__content">
    {%- if section.settings.heading != blank -%}
      <h2 class="h1">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subtext != blank -%}
      <div class="rte">{{ section.settings.subtext }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="button button--primary">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Brand Story Video",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video (MP4)",
      "info": "Recommended for best performance and seamless autoplay."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "External Video URL",
      "info": "Used if no Shopify-hosted video is provided."
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Poster Image",
      "info": "Shown on devices with reduced motion preferences."
    },
    {
      "type": "range",
      "id": "video_height",
      "min": 40,
      "max": 100,
      "step": 10,
      "unit": "vh",
      "label": "Section height",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Mute video",
      "default": true
    },
    {
      "type": "header",
      "content": "Text Overlay"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Brand Story"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Discover the inspiration behind our latest collection.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 30
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Brand Story Video"
    }
  ]
}
{% endschema %}
