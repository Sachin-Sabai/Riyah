{% comment %}
  Premium Editorial Product Card
  Accepts:
  - card_product: {Object} Product Liquid object
  - show_secondary_image: {Boolean}
  - show_vendor: {Boolean}
  - lazy_load: {Boolean}
{% endcomment %}

<style>
  .premium-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    width: 100%;
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
    box-shadow: none;
  }

  .premium-card__media-box {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: #f4f4f4; /* Minimal loading skeleton color */
    margin-bottom: 1.5rem;
  }

  .premium-card__img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    max-width: none !important;
    transition: transform 650ms cubic-bezier(0.25, 0.46, 0.45, 0.94), filter 650ms cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 650ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform, opacity, filter;
  }

  .premium-card__img--secondary {
    opacity: 0;
    z-index: 2;
  }

  /* Luxury Hover */
  .premium-card:hover .premium-card__img--primary {
    transform: scale(1.05);
    {% if show_secondary_image and card_product.media[1] %}
      opacity: 0;
    {% else %}
      filter: brightness(1.02);
    {% endif %}
  }

  .premium-card:hover .premium-card__img--secondary {
    opacity: 1;
    transform: scale(1.05);
    filter: brightness(1.02);
  }

  .premium-card__info-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 1rem;
  }

  .premium-card__vendor-text {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #999;
    margin-bottom: 0.6rem;
  }

  .premium-card__title-text {
    font-family: var(--font-heading-family);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #000;
    margin: 0 0 1rem 0;
    line-height: 1.2;
  }

  .premium-card__price-box {
    font-size: 1.5rem;
    color: #000;
    letter-spacing: 0.05em;
  }
</style>

{%- if card_product and card_product != empty -%}
  <a href="{{ card_product.url }}" class="premium-card">
    <div class="premium-card__media-box">
      {%- if card_product.featured_media -%}
        {%- assign fetch_priority = 'auto' -%}
        {%- if lazy_load == false -%}
          {%- assign fetch_priority = 'high' -%}
        {%- endif -%}

        {{ card_product.featured_media | image_url: width: 1500 | image_tag: 
            class: 'premium-card__img premium-card__img--primary',
            loading: lazy_load | default: 'lazy',
            fetchpriority: fetch_priority,
            sizes: '(min-width: 990px) 33vw, 50vw',
            widths: '360, 533, 720, 940, 1066, 1500'
        }}

        {%- if show_secondary_image and card_product.media[1] != nil -%}
          {{ card_product.media[1] | image_url: width: 1500 | image_tag: 
              class: 'premium-card__img premium-card__img--secondary',
              loading: 'lazy',
              sizes: '(min-width: 990px) 33vw, 50vw',
              widths: '360, 533, 720, 940, 1066, 1500'
          }}
        {%- endif -%}
      {%- else -%}
        <div class="premium-card__img" style="display:flex; align-items:center; justify-content:center; background: #f4f4f4;">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

    <div class="premium-card__info-box">
      {%- if show_vendor and card_product.vendor != blank -%}
        <div class="premium-card__vendor-text">{{ card_product.vendor }}</div>
      {%- endif -%}
      <h3 class="premium-card__title-text">
        {{ card_product.title | escape }}
      </h3>
      <div class="premium-card__price-box">
        {% render 'price', product: card_product, price_class: '' %}
      </div>
    </div>
  </a>
{%- else -%}
  <div class="premium-card">
    <div class="premium-card__media-box">
      <div class="premium-card__img" style="display:flex; align-items:center; justify-content:center; background: #f4f4f4;">
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    </div>
    <div class="premium-card__info-box">
      {%- if show_vendor -%}
        <div class="premium-card__vendor-text">Designer Label</div>
      {%- endif -%}
      <h3 class="premium-card__title-text">Premium Example Product</h3>
      <div class="premium-card__price-box">
        <span class="price-item price-item--regular">$299.00</span>
      </div>
    </div>
  </div>
{%- endif -%}
